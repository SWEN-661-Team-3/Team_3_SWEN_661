# CareConnect Environment Variables
# Copy this file to .env.local for local development.
# Variables prefixed with VITE_ are exposed to the browser -- do not put secrets here.

# Application environment: development locally, production on a deployed build.
VITE_APP_ENV=development

# Base URL for PWA manifest and OG meta tags. This is required in production.
VITE_PUBLIC_SITE_URL=http://localhost:5173

# Test/development controls. Never enable mock failures in a deployed environment.
VITE_ENABLE_MOCK_FAILURES=false
VITE_SERVICE_DELAY_MS=40
